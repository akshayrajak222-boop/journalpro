# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase database configuration for persistence
SUPABASE_URL=
SUPABASE_KEY=

# Frontend site URL used after Supabase OAuth redirects
VITE_SITE_URL=https://www.fxjournalpro.com

# MetaApi token for MT5 investor password sync (TradeZella-style broker sync)
# Get your free token at: https://app.metaapi.cloud → Dashboard → API Tokens
# Free tier: 5 MT5 accounts
META_API_TOKEN=

# EA machine-to-machine auth hardening (Phase 2)
# EA_ALLOW_LEGACY_TOKEN: when "false", EA requests MUST present an HMAC signature
# (Authorization: Bearer + X-EA-Signature + X-EA-Timestamp). Default true so
# previously downloaded EA files keep working.
EA_ALLOW_LEGACY_TOKEN=true
# EA_SIGNATURE_WINDOW_MIN: replay protection window for X-EA-Timestamp (minutes)
EA_SIGNATURE_WINDOW_MIN=5

# MT5_CREDENTIAL_MASTER_KEY: 32-byte (64 hex chars) master key for the cloud
# bridge (investor-password) method. Investor passwords are encrypted with
# AES-256-GCM under a random DEK that is envelope-wrapped with this key — the
# raw password is never stored. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, POST /api/mt5/cloud/connect returns 503 CLOUD_NOT_CONFIGURED and
# falls back to the EA method (which never touches the password).
MT5_CREDENTIAL_MASTER_KEY=

# SendGrid API Key for sending Email OTP verification codes
# Get your free key at: https://sendgrid.com (Free tier allows 100 emails/day)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Resend API Key for sending Email OTP verification codes
# Get your key at: https://resend.com
RESEND_API_KEY=

# Cloudflare Turnstile Verification Keys
# Get your keys at: https://dash.cloudflare.com/?to=/:account/turnstile
# (VITE_ prefixed so it's exposed to the Vite React frontend)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# FX News (Alpha Vantage News & Sentiment API)
# Free key at: https://www.alphavantage.co/support/#api-key (25 requests/day)
ALPHA_VANTAGE_API_KEY=

# Economic Calendar (modular provider, cached server-side)
# Providers: "xoomar" (free, no key, default — US CPI/NFP/FOMC/GDP from BLS/Fed/BEA),
#            "finnhub" (free tier used to include the calendar — currently restricted),
#            "fmp" (paid plan required)
ECONOMIC_CALENDAR_PROVIDER=xoomar

# Xoomar Economic Calendar needs no API key (30 req/min/IP; optional free key at https://xoomar.com/signup)
# Docs: https://xoomar.com/markets/api/calendar

# Finnhub API Key for the Economic Calendar (only if using ECONOMIC_CALENDAR_PROVIDER=finnhub)
# Free key at: https://finnhub.io/register (note: economic calendar may be restricted on free tier)
FINNHUB_API_KEY=

# Financial Modeling Prep API Key (only if using ECONOMIC_CALENDAR_PROVIDER=fmp)
# Free key at: https://site.financialmodelingprep.com/ (note: free tier does NOT include the calendar)
FMP_API_KEY=
